{
  "name": "motoka-painel",
  "version": "0.1.0",
  "private": true,
  "description": "Painel web do estabelecimento (Next.js, export estático).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build && node scripts/postbuild.mjs",
    "serve": "wrangler dev --port 8787",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p static-pages/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "check-error-codes": "node scripts/check-error-codes.mjs",
    "e2e:devenv": "playwright test -c playwright.devenv.config.ts",
    "size:login": "node scripts/size-login.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "eventsource-parser": "4.1.1",
    "maplibre-gl": "6.12.0",
    "next": "16.3.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.47.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "27.4.0",
    "msw": "2.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
